{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "start": "tsx server.ts",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "cf:dev": "vite build && wrangler dev",
    "cf:deploy": "vite build && wrangler deploy",
    "smoke:node": "tsx scripts/smoke-node.ts",
    "smoke:http": "tsx scripts/smoke-http.ts",
    "typecheck": "tsc --noEmit",
    "smoke:handlers": "tsx scripts/smoke-handlers.ts",
    "export:patterns": "tsx scripts/export-pattern.ts",
    "sdk:test": "npm --prefix packages/image-studio test && tsx --test packages/image-studio/test/contract.test.ts",
    "sdk:build": "npm --prefix packages/image-studio run build"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "fflate": "^0.8.3",
    "gifenc": "^1.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "omggif": "^1.0.10",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "satori": "^0.34.1",
    "sharp": "^0.35.5",
    "tsx": "^4.21.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261031.1",
    "@netlify/functions": "^6.0.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/omggif": "^1.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sharp": "^0.32.0",
    "@vercel/node": "^17.0.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.156.0"
  }
}
