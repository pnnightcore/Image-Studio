{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/animated/frame", "destination": "/api/animation/frame" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "node_modules/{harfbuzzjs/hb.wasm,satori/yoga.wasm},public/fonts/**"
    }
  }
}
